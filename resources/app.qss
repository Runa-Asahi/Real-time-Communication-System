/* 群页外观。MainWindowFanLX 构造时经 QApplication::setStyleSheet 加载。
   选择器都挂在 QWidget#groupPageFanLX 下，避免改到聊天、好友、账号页和对话框。
   色值、圆角和字号与 AppThemeFanLX / 好友页 / 账号页同一套。 */

QWidget#groupPageFanLX {
    background: #F6F7F9;
    color: #1F2329;
    font-size: 14px;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
}

QScrollArea#groupScrollFanLX,
QWidget#groupViewportFanLX {
    background: #F6F7F9;
    border: none;
}

QWidget#groupPageFanLX QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E6E8EE;
    border-radius: 12px;
}

QWidget#groupPageFanLX QLabel[role="pageTitle"],
QWidget#groupPageFanLX QLabel[role="title"] {
    font-size: 20px;
    font-weight: 600;
    color: #1F2329;
    background: transparent;
}

QWidget#groupPageFanLX QLabel[role="sectionTitle"] {
    font-size: 15px;
    font-weight: 600;
    color: #1F2329;
    background: transparent;
}

QWidget#groupPageFanLX QLabel[role="hint"] {
    color: #5B6472;
    font-size: 13px;
    background: transparent;
}

QWidget#groupPageFanLX QLabel[fanlxKind="scope"] {
    color: #5B6472;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

QWidget#groupPageFanLX QLabel[role="empty"] {
    color: #8A94A3;
    font-size: 13px;
    background: transparent;
}

QWidget#groupPageFanLX QListWidget#groupPendingListFanLX,
QWidget#groupPageFanLX QListWidget#groupDiscussionListFanLX {
    background: transparent;
    border: none;
}

/* 分组框标题改由卡片里的 QLabel 显示，这里把原生标题收掉，避免两套标题叠在一起。
   title() 字符串保留，页面文本扫描仍能读到。 */
QWidget#groupPageFanLX QGroupBox {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
}

QWidget#groupPageFanLX QGroupBox::title {
    color: transparent;
    padding: 0;
    height: 0;
    font-size: 0px;
}

QWidget#groupPageFanLX QLineEdit {
    background: #FFFFFF;
    color: #1F2329;
    border: 1px solid #E6E8EE;
    border-radius: 8px;
    padding: 0px 10px;
    font-size: 14px;
    min-height: 36px;
    selection-background-color: #E8EFFD;
    selection-color: #1F2329;
}

QWidget#groupPageFanLX QLineEdit[fanlxKind="mono"] {
    font-family: Consolas, "Cascadia Mono", "Courier New", monospace;
    color: #5B6472;
}

QWidget#groupPageFanLX QLineEdit:focus {
    border: 1px solid #2563EB;
}

QWidget#groupPageFanLX QLineEdit:disabled {
    background: #F6F7F9;
    color: #8A94A3;
}

QWidget#groupPageFanLX QListView,
QWidget#groupPageFanLX QListWidget {
    background: #FFFFFF;
    color: #1F2329;
    border: 1px solid #E6E8EE;
    border-radius: 12px;
    outline: none;
    font-size: 14px;
}

QWidget#groupPageFanLX QListView::item,
QWidget#groupPageFanLX QListWidget::item {
    padding: 10px 12px;
    border-left: 3px solid transparent;
    color: #1F2329;
}

QWidget#groupPageFanLX QListView::item:hover,
QWidget#groupPageFanLX QListWidget::item:hover {
    background: #F3F5F8;
}

QWidget#groupPageFanLX QListView::item:selected,
QWidget#groupPageFanLX QListWidget::item:selected,
QWidget#groupPageFanLX QListView::item:selected:hover,
QWidget#groupPageFanLX QListWidget::item:selected:hover {
    background: #E8EFFD;
    border-left: 3px solid #2563EB;
    color: #1F2329;
}

QWidget#groupPageFanLX QPlainTextEdit {
    background: #F3F5F8;
    color: #1F2329;
    border: 1px solid #E6E8EE;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 14px;
    selection-background-color: #E8EFFD;
    selection-color: #1F2329;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="primary"] {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 600;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="primary"]:hover {
    background: #1D4ED8;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="primary"]:pressed {
    background: #1E40AF;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="primary"]:disabled {
    background: #E6E8EE;
    color: #8A94A3;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="danger"] {
    background: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 600;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="danger"]:hover {
    background: #FEE2E2;
    border-color: #DC2626;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="danger"]:pressed {
    background: #FEE2E2;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="danger"]:disabled {
    color: #FECACA;
    border-color: #FEE2E2;
    background: #FFFFFF;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="nav"] {
    background: #FFFFFF;
    color: #1F2329;
    border: 1px solid #E6E8EE;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="nav"]:hover {
    background: #F3F5F8;
    border-color: #D7DEE8;
    color: #1F2329;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="nav"]:pressed {
    background: #E8EFFD;
    border-color: #2563EB;
    color: #2563EB;
}

QWidget#groupPageFanLX QPushButton[fanlxKind="nav"]:disabled {
    color: #8A94A3;
    background: #F6F7F9;
    border-color: #E6E8EE;
}

QWidget#groupPageFanLX QPushButton[role="back"] {
    color: #2563EB;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px 8px;
    min-width: 0;
    min-height: 0;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
}

QWidget#groupPageFanLX QPushButton[role="back"]:hover {
    background: #E8EFFD;
}

QWidget#groupPageFanLX QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QWidget#groupPageFanLX QScrollBar::handle:vertical {
    background: #cfd6df;
    border-radius: 3px;
    min-height: 36px;
}

QWidget#groupPageFanLX QScrollBar::handle:vertical:hover {
    background: #b3bcc8;
}

QWidget#groupPageFanLX QScrollBar::add-line:vertical,
QWidget#groupPageFanLX QScrollBar::sub-line:vertical {
    height: 0;
}

QWidget#groupPageFanLX QScrollBar::add-page:vertical,
QWidget#groupPageFanLX QScrollBar::sub-page:vertical {
    background: transparent;
}
