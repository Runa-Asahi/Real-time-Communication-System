# ---- 构建输出（CMake 生成，可随时重建）----
/build/
/build-*/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json

# ---- 临时工作产物（渲染图、日志、一次性脚本）----
/.artifacts/
*.clangd.log
*.log

# ---- 编辑器 / 语言服务器缓存 ----
/.cache/
/.vscode/
/.claude/
/.zed/
*.log.clangd

# ---- 运行时数据目录（由 --init-demo 或程序首次启动生成）----
/data-*/
/data/*.json
/data/*.json.prev
/data/*.lock
# 在源码树里直接双击 scripts/release/Ciallo.bat 时，数据写在启动器旁边。
/scripts/release/data/

# ---- 客户端 GUI 默认数据根（2026-10-10 从 build/ 移出）----
# 此前它位于 build/data-im-gui，仅靠上面的 /build/ 才被忽略。但 /build/ 的语义是
# 「可随时删除重建」，全量重建会连聊天记录（chat.db / state.json）一起抹掉，
# 且不受 git 保护。现已移到项目根，与 data-im-a / data-im-b / data-im-server 平级，
# 由上面的 /data-*/ 规则统一覆盖。此条是显式冗余声明，防止规则被误改。
/data-im-gui/

# ---- 登录凭据载体（明文口令写在 data-*/state.json 的 users[].password 里）----
# 旧实现的独立令牌总表已随「用户名 + 密码」改造删除；这里保留忽略规则，
# 防止历史工作目录里遗留的令牌文件被误提交。
/im-tokens.json

# ---- 本机编辑器配置（路径和权限只对这一台电脑有意义）----
.claude/
.zed/

# ---- 编译与本机产物 ----
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.pdb
*.ilk
*.stackdump
